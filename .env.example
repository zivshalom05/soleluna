# sole&luna — production environment variables
# Replit: add each under Secrets (lock icon), NOT in code.

# ---- Grow (Meshulam) payment — REQUIRED for live sales ----
GROW_USER_ID=your-grow-user-id
GROW_PAGE_CODE=your-grow-page-code
GROW_API_KEY=your-grow-api-key
GROW_ENV=sandbox
# GROW_ENV=production

# ---- Security ----
ADMIN_PASS=choose-a-strong-password-here
NODE_ENV=production
ALLOW_DEMO_CHECKOUT=false

# ---- Email notifications + 12h monitoring report (Resend.com) ----
# NOTIFY_EMAIL — where order alerts AND the Watchtower report are sent.
NOTIFY_EMAIL=zivshalom05@gmail.com
# RESEND_API_KEY — required for real email delivery (without it, mail is only logged).
# RESEND_API_KEY=re_xxxxxxxx
# FROM_EMAIL=orders@soleluna.co.il

# ---- Watchtower (24/7 monitoring) ----
# CRON_KEY — secret for the external scheduler that fires /api/cron/report.
CRON_KEY=change-me-to-a-random-string
# How often the summary email is sent (hours). Default 12.
REPORT_INTERVAL_HOURS=12
# Alert when a variant's stock drops to this or below. Default 3.
LOW_STOCK_THRESHOLD=3

# ---- Server ----
PORT=3000
